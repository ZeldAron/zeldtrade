# ZeldTrade Cloud Functions — secrets (Firebase Secret Manager)
#
# Ce fichier documente les secrets ATTENDUS par les Cloud Functions.
# IMPORTANT : les valeurs réelles ne sont JAMAIS stockées ici, ni dans le repo.
# Elles vivent dans Google Secret Manager et sont injectées au runtime.
#
# Pour gérer un secret :
#   firebase functions:secrets:set NOM_SECRET    --project zeldtrade
#   firebase functions:secrets:access NOM_SECRET --project zeldtrade
#   firebase functions:secrets:destroy NOM_SECRET --project zeldtrade
#
# Après une modification, redéployer les CFs qui consomment le secret :
#   firebase deploy --only functions --project zeldtrade

# ─── IA ──────────────────────────────────────────────────────────────────────
# Groq Vision (Llama 4 Scout/Maverick) — IA primaire pour analyzeChart
# Console : https://console.groq.com/keys
GROQ_API_KEY=

# Anthropic Claude (claude-sonnet-4-6) — fallback IA Funded/Elite/Beta
# Console : https://console.anthropic.com/settings/keys
CLAUDE_API_KEY=

# ─── Anti-bot ────────────────────────────────────────────────────────────────
# hCaptcha — anti-bot signup/contact form (clé secrète serveur)
# Console : https://dashboard.hcaptcha.com/sites
HCAPTCHA_SECRET=

# Cloudflare Turnstile — anti-bot analyzeChart (clé secrète serveur)
# Console : https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SECRET=

# ─── Discord webhooks ────────────────────────────────────────────────────────
# Webhook URL Discord — canal #support-tickets (contact form)
DISCORD_SUPPORT_WEBHOOK=
# Webhook URL Discord — canal #new-users (notifyNewSignup)
DISCORD_SIGNUP_WEBHOOK=
# Webhook URL Discord — canal #dev-logs (Sentry-lite via _wrapCF)
DISCORD_ERRORS_WEBHOOK=

# ─── Stripe ──────────────────────────────────────────────────────────────────
# Stripe secret key (sk_live_… en prod, sk_test_… en dev)
# Console : https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Stripe webhook signing secret (whsec_…)
# Console : https://dashboard.stripe.com/webhooks → endpoint → Signing secret
# Endpoint URL : https://stripewebhook-6ymqeo7knq-ew.a.run.app
# Events : checkout.session.completed, customer.subscription.updated,
#          customer.subscription.deleted, invoice.payment_failed
STRIPE_WEBHOOK_SECRET=
# v0.9.255 : IDs Stripe Prices (price_…) — modèle self-service Funded/Elite × mensuel/annuel
# Console : https://dashboard.stripe.com/products → créer 2 produits, 2 prix chacun
STRIPE_PRICE_FUNDED_MONTHLY=
STRIPE_PRICE_FUNDED_YEARLY=
STRIPE_PRICE_ELITE_MONTHLY=
STRIPE_PRICE_ELITE_YEARLY=

# ─── Newsletter ──────────────────────────────────────────────────────────────
# Clé HMAC pour signer les tokens de désinscription RFC 8058
# Génération : openssl rand -hex 32
UNSUBSCRIBE_HMAC_KEY=

# Token d'authentification pour le webhook Brevo (events bounce/spam/blocked)
# Génération : openssl rand -hex 32
# Configuration côté Brevo Dashboard → Webhooks :
#   URL     : https://europe-west1-zeldtrade.cloudfunctions.net/brevoWebhook
#   Headers : Authorization: Bearer <BREVO_WEBHOOK_TOKEN>
#   Events  : hard_bounce, soft_bounce, blocked, spam, complaint, unsubscribed
BREVO_WEBHOOK_TOKEN=
