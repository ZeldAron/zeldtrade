rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // v0.9.249 (S-NEW-16 fix) : un user "Pro" a un doc Firestore
    // users/{uid}/data/plan avec plan == 'pro' (couvre funded/elite/beta).
    // On lit ce doc cross-service pour enforcer le gating tier CÔTÉ SERVEUR
    // (avant : gating client-only, contournable via DevTools).
    function isProUser(userId) {
      return firestore.exists(/databases/(default)/documents/users/$(userId)/data/plan)
          && firestore.get(/databases/(default)/documents/users/$(userId)/data/plan).data.plan == 'pro';
    }

    // Screenshots de trades : Pro only, max 3 captures par trade, owner only.
    // v0.9.249 (S-NEW-16/19 fix) :
    //   - write réservé aux comptes Pro (Trader gratuit = 0 capture stockée)
    //   - filename strictement borné : screenshot.jpg | screenshot_1.* | screenshot_2.*
    //     → cap dur à 3 fichiers physiques par trade (anti-abus stockage illimité)
    match /users/{userId}/trades/{tradeId}/{filename} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.auth.token.email_verified == true
                   && isProUser(userId)
                   && filename.matches('screenshot(_[12])?[.](jpe?g|png|webp)')
                   && request.resource.size < 2 * 1024 * 1024              // 2 MB max après compression
                   && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Default-deny global
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
