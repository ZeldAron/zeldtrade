rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper unique : "est-ce le compte admin authentifié, email vérifié ?"
    // Email hardcodé volontairement (single-tenant). Pour ajouter un 2e admin,
    // utiliser un custom claim Firebase plutôt que d'allonger cette liste.
    function isAdmin() {
      return request.auth != null
          && request.auth.token.email == 'zeldtradepro@gmail.com'
          && request.auth.token.email_verified == true;
    }

    // Helper : "user authentifié ET email vérifié". Defense-in-depth contre
    // un attaquant qui aurait compromis le client (XSS, token volé) sans avoir
    // validé l'email. Les Cloud Functions critiques (analyzeChart, signup)
    // exigent déjà email_verified côté serveur ; on l'aligne ici sur les writes
    // Firestore client (S-NEW-01 v0.9.230). NB : la création initiale du doc
    // userEmails au signup et l'activation d'un code Pro restent autorisées
    // SANS email_verified pour ne pas casser le flow d'onboarding.
    function isVerified(userId) {
      return request.auth != null
          && request.auth.uid == userId
          && request.auth.token.email_verified == true;
    }

    // Fail-closed par défaut : toute collection non explicitement matchée
    // refuse read+write. Toute nouvelle collection doit être ajoutée ci-dessous
    // avec ses propres conditions sinon elle reste inaccessible.
    match /{document=**} {
      allow read, write: if false;
    }

    // ── Profils utilisateurs (lookup admin) ──────────────────────────────────────
    match /userEmails/{uid} {
      allow get:    if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow list:   if isAdmin();
      allow delete: if request.auth != null && request.auth.uid == uid;
      // ── HOTFIX 2026-06-02 (prod, SANS bump de version) ───────────────────────
      // La modale CGU bouclait en `permission-denied` : l'ancienne règle re-validait
      // tout le doc (email == token.email, regex `username`, anti-usurpation, types
      // stricts) à chaque écriture. Sur un doc legacy/incomplet (ou un create de
      // consentement), une de ces conditions échouait silencieusement → write refusé →
      // consentement jamais sauvegardé → modale en boucle.
      //
      // Règle robuste, owner-scoped : un user ne peut écrire QUE son propre doc, avec
      // uniquement les 6 clés connues et des types corrects. Chaque check est
      // conditionnel (un champ absent ne fait pas échouer). Passe aussi bien un create
      // complet qu'un simple merge {termsAccepted,newsletterOptIn}.
      //
      // Sécurité : `uid == auth.uid` (écriture limitée à son propre doc), pas de clé
      // inconnue, aucune escalade possible (l'admin est déterminé par claim email, PAS
      // par ce doc). TODO re-tighten : anti-usurpation du pseudo + email==token.email à
      // ré-appliquer côté serveur (Cloud Function) plutôt que dans les rules.
      allow create, update: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['uid', 'email', 'username', 'lastSeen', 'termsAccepted', 'newsletterOptIn'])
                    && (!('uid' in request.resource.data)      || request.resource.data.uid == uid)
                    && (!('email' in request.resource.data)    || (request.resource.data.email is string && request.resource.data.email.size() <= 254))
                    && (!('username' in request.resource.data) || (request.resource.data.username is string && request.resource.data.username.size() <= 50))
                    && (!('lastSeen' in request.resource.data) || request.resource.data.lastSeen is int)
                    && (!('termsAccepted' in request.resource.data)   || request.resource.data.termsAccepted is map)
                    && (!('newsletterOptIn' in request.resource.data) || request.resource.data.newsletterOptIn is bool);
    }

    // ── Codes Pro (hashes) ───────────────────────────────────────────────────────
    // La génération passe désormais par la Cloud Function `generateProCode` (admin SDK)
    // qui enforce rate-limit + cap + audit log. Plus aucune écriture côté client.
    // Note : `get` autorisé pour le destinataire afin que la rule plan puisse
    // résoudre via `get(...)` lors de l'activation.
    // Self-delete : un user peut delete les codes qui lui sont attribués (utile pour
    // le droit à l'effacement RGPD — un user qui supprime son compte peut purger ses codes).
    match /proCodeHashes/{hash} {
      allow get:    if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow list:   if isAdmin();
      allow create, update: if false;  // CF only
      allow delete: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
    }

    // ── Rate-limit admin (writes via Cloud Function uniquement) ─────────────────
    match /adminRateLimit/{action} {
      allow read:   if isAdmin();
      allow write, delete: if false;
    }

    // ── Rate-limit par IP (v0.9.160 : fallback Turnstile pour Safari/Firefox sans
    // extensions). Écrit UNIQUEMENT par analyzeChart CF via admin SDK. Aucun
    // accès client : un attaquant ne peut pas falsifier l'historique de son IP.
    match /ipRateLimit/{ip} {
      allow read:   if isAdmin();
      allow write, delete: if false;
    }

    // ── Soft-deleted users (archive 30j avant purge définitive) ─────────────────
    // Écrit par Cloud Function lors d'un deleteUserAccount, accessible admin uniquement
    // pour restauration manuelle dans les 30 jours. Aucun accès client.
    match /deletedUsers/{uid}/{document=**} {
      allow read:   if isAdmin();
      allow write, delete: if false;
    }

    // ── Trades — seuls les champs attendus, limite taille ────────────────────────
    match /users/{userId}/data/trades {
      allow read:   if (request.auth != null && request.auth.uid == userId) || isAdmin();
      allow delete: if isVerified(userId);
      allow write:  if isVerified(userId)
                   && request.resource.data.keys().hasOnly(['items'])
                   && request.resource.data.items is list
                   && request.resource.data.items.size() <= 10000;
    }

    // ── Settings — whitelist stricte des champs, types validés ──────────────────
    match /users/{userId}/data/settings {
      allow read:   if (request.auth != null && request.auth.uid == userId) || isAdmin();
      allow delete: if isVerified(userId);
      // v1.0.x : ajout de selectedFirms / focusScope / setupDone à la whitelist.
      // AVANT, ces 3 champs (toujours présents via DEFAULT_SETTINGS) faisaient échouer
      // hasOnly() → TOUTE écriture settings était refusée (permission-denied) → le setup
      // ne se persistait jamais en Firestore → wizard redemandé sur un autre appareil.
      allow write:  if isVerified(userId)
                   && request.resource.data.keys().hasOnly(['capital', 'contracts', 'instrument', 'tradingTypes', 'favInstruments', 'selectedFirms', 'focusScope', 'setupDone', 'journalFields'])
                   && request.resource.data.capital is number
                   && request.resource.data.capital >= 0
                   && request.resource.data.capital <= 1000000000
                   && request.resource.data.contracts is number
                   && request.resource.data.contracts >= 0.01
                   && request.resource.data.contracts <= 999
                   && request.resource.data.instrument is string
                   && request.resource.data.instrument.size() <= 20
                   && (!('tradingTypes' in request.resource.data)
                       || request.resource.data.tradingTypes == null
                       || (request.resource.data.tradingTypes is list
                           && request.resource.data.tradingTypes.size() >= 1
                           && request.resource.data.tradingTypes.size() <= 3))
                   && (!('favInstruments' in request.resource.data)
                       || (request.resource.data.favInstruments is list
                           && request.resource.data.favInstruments.size() <= 100))
                   && (!('selectedFirms' in request.resource.data)
                       || (request.resource.data.selectedFirms is list
                           && request.resource.data.selectedFirms.size() <= 20))
                   && (!('focusScope' in request.resource.data)
                       || request.resource.data.focusScope == null
                       || (request.resource.data.focusScope is string
                           && request.resource.data.focusScope.size() <= 80
                           && request.resource.data.focusScope.matches('^(acc:|grp:|firm:).+')))
                   && (!('setupDone' in request.resource.data)
                       || request.resource.data.setupDone is bool)
                   // v1.0.2 : journal personnalisable. Validation fine côté client
                   // (_sanitizeJournalFields) ; ici on borne juste au type map/null
                   // (cohérent avec l'archi : on ne valide pas les sous-clés en rules).
                   && (!('journalFields' in request.resource.data)
                       || request.resource.data.journalFields == null
                       || request.resource.data.journalFields is map);
    }

    // ── Notifications (centre de notifs, v0.9.305) ───────────────────────────
    // Historique des messages UI, rattaché au compte → suit l'user d'un appareil
    // à l'autre. Données non sensibles ; on borne juste la taille (cap 30 client).
    match /users/{userId}/data/notifications {
      allow read:   if (request.auth != null && request.auth.uid == userId) || isAdmin();
      allow delete: if isVerified(userId);
      allow write:  if isVerified(userId)
                    && request.resource.data.keys().hasOnly(['items', 'updatedAt'])
                    && request.resource.data.items is list
                    && request.resource.data.items.size() <= 50;
    }

    // ── Mes comptes — 1 max Basic, 100 max Pro ───────────────────────────────────
    // S21 (v0.9.122) : retrait du bypass `isAdmin() ||` sur `allow write`.
    // L'admin garde le read pour l'audit/modération, mais ne peut plus écrire les
    // myAccounts d'un autre user via les rules client. Si une action admin nécessite
    // d'écrire ces données (support), elle doit passer par une Cloud Function avec
    // l'admin SDK + audit log immuable (traçabilité). Cela ferme la porte à une
    // compromission admin (XSS / token volé) qui aurait pu corrompre les comptes users.
    match /users/{userId}/data/myAccounts {
      allow read:   if (request.auth != null && request.auth.uid == userId) || isAdmin();
      allow delete: if isVerified(userId);
      allow write:  if isVerified(userId)
                    && request.resource.data.keys().hasOnly(['items'])
                    && request.resource.data.items is list
                    && (
                      request.resource.data.items.size() <= 1
                      || (
                        exists(/databases/$(database)/documents/users/$(userId)/data/plan)
                        && get(/databases/$(database)/documents/users/$(userId)/data/plan).data.plan == 'pro'
                        && request.resource.data.items.size() <= 100
                      )
                    );
    }

    // ── Clé IA — DEPRECATED, déplacée dans Google Secret Manager ─────────────
    // Anciennement lisible par tout user authentifié → exposait la clé Groq en
    // clair côté DevTools. La clé vit désormais dans Secret Manager et est
    // injectée uniquement dans la Cloud Function `analyzeChart`. Ce document
    // Firestore reste verrouillé pour rétro-compatibilité (anciens clients).
    match /config/groq {
      allow read, write: if false;
    }

    // ── Spreads par firm ─────────────────────────────────────────────────────────
    match /users/{userId}/data/spreadsByFirm {
      allow read:   if (request.auth != null && request.auth.uid == userId) || isAdmin();
      allow delete: if isVerified(userId);
      allow write:  if isVerified(userId)
                   && request.resource.data.keys().hasOnly(['apex', 'topstep', 'ftmo', 'ftmo1step', 'lucid', 'fpips'])
                   && request.resource.data.size() <= 6;
    }

    // ── Groupes — Pro uniquement ─────────────────────────────────────────────────
    match /users/{userId}/data/groups {
      allow read:   if (request.auth != null && request.auth.uid == userId) || isAdmin();
      allow delete: if isVerified(userId);
      allow write:  if isVerified(userId)
                   && request.resource.data.keys().hasOnly(['items'])
                   && request.resource.data.items is list
                   && request.resource.data.items.size() <= 50
                   && exists(/databases/$(database)/documents/users/$(userId)/data/plan)
                   && get(/databases/$(database)/documents/users/$(userId)/data/plan).data.plan == 'pro';
    }

    // ── AI usage — écriture exclusivement par Cloud Function (admin SDK) ─────────
    // Le client peut LIRE pour afficher son quota, mais NE peut PAS écrire ni
    // supprimer (sinon bypass trivial via DevTools : delete puis recreate à 0).
    match /users/{userId}/data/aiUsage {
      allow read:   if request.auth != null && request.auth.uid == userId;
      allow write:  if false;
      allow delete: if false;
    }

    // ── Throttle contact (write par Cloud Function uniquement) ──────────────────
    match /users/{userId}/data/contactThrottle {
      allow read:   if request.auth != null && request.auth.uid == userId;
      allow write, delete: if false;
    }

    // ── Signup notified flag (idempotence Cloud Function notifyNewSignup) ───────
    match /users/{userId}/data/signupNotified {
      allow read:   if request.auth != null && request.auth.uid == userId;
      allow write, delete: if false;
    }

    // ── Plan Pro — write (create OR update), code consommable une fois, lié à l'uid ─
    // On autorise update pour gérer les cas legacy où un doc plan existe déjà.
    // Le code Pro DOIT être unconsumed (pas de consumedAt sur proCodeHashes) ou
    // déjà consommé par CE même user (réactivation idempotente après reset client).
    match /users/{userId}/data/plan {
      allow read:   if (request.auth != null && request.auth.uid == userId) || isAdmin();
      allow delete: if isAdmin();
      // v0.9.211 : champ 'tier' ajouté (4 valeurs : trader/funded/elite/beta).
      // Client ne peut écrire que tier='beta' (workflow Founding Members).
      // Les écritures Stripe (tier='funded'/'elite') passent par admin SDK qui bypasse les rules.
      allow write:  if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.keys().hasOnly(['plan', 'activatedAt', 'codeHash', 'tier'])
                    && request.resource.data.plan == 'pro'
                    && (!('tier' in request.resource.data) || request.resource.data.tier == 'beta')
                    && request.resource.data.activatedAt is int
                    && request.resource.data.activatedAt > 1700000000000
                    && request.resource.data.activatedAt <= request.time.toMillis()
                    && request.resource.data.codeHash is string
                    && request.resource.data.codeHash.size() <= 128
                    && exists(/databases/$(database)/documents/proCodeHashes/$(request.resource.data.codeHash))
                    && get(/databases/$(database)/documents/proCodeHashes/$(request.resource.data.codeHash)).data.uid == request.auth.uid;
    }

    // ── Audit logs (immuable, écrit uniquement par Cloud Function admin SDK) ────
    match /auditLogs/{logId} {
      allow read:   if isAdmin();
      allow write, delete: if false;
    }

    // ── Subscription Stripe (read par owner + admin, write par webhook uniquement) ─
    match /users/{userId}/data/stripe {
      allow read: if (request.auth != null && request.auth.uid == userId) || isAdmin();
      allow write, delete: if false;
    }

    // ── Stats publiques agrégées (compteur d'inscrits affiché sur la landing) ─
    // Écrit par les CFs (notifyNewSignup increment). Lu via la CF getPublicStats
    // (callable anonyme) — pas d'accès client direct nécessaire. Aucune PII.
    match /publicStats/{doc} {
      allow read:  if isAdmin();
      allow write, delete: if false;
    }

    // ── Events Brevo (transactional webhooks : bounces/spam/blocked) ─────────
    // Écrits exclusivement par la Cloud Function `brevoWebhook` (admin SDK).
    // Read admin pour traçabilité / debug ops. TTL 90j via champ `expireAt`.
    match /emailEvents/{eventId} {
      allow read:  if isAdmin();
      allow write, delete: if false;
    }

    // ── Idempotence Stripe webhook events (TTL 30j) ─────────────────────────
    // Écrits par stripeWebhook CF pour bloquer les replays. Read admin.
    match /stripeWebhookEvents/{eventId} {
      allow read:  if isAdmin();
      allow write, delete: if false;
    }

    // ── Analytics produit (v0.9.277) — pages vues + actions clés ────────────
    // Écrit par l'utilisateur connecté pour SES propres events (uid == auth.uid).
    // Read admin (onglet Activité). Pas d'update/delete côté client.
    // Schéma strict : type, uid, sid, ts, + page/label optionnels.
    match /analyticsEvents/{eventId} {
      allow read:   if isAdmin();
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.type is string
                    && request.resource.data.type.size() <= 40
                    && request.resource.data.sid is string
                    && request.resource.data.sid.size() <= 24
                    && request.resource.data.keys().hasOnly(['type','uid','sid','ts','page','label']);
      allow update, delete: if false;
    }
  }
}
